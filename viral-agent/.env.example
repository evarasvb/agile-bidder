# Meta Graph API (Facebook Page + Instagram Business)
# ====================================================
# Guía completa de cómo obtenerlas: ver README.md, sección 3.

# ID de tu Página de Facebook (Meta Business Suite → Configuración → Info de la Página)
META_PAGE_ID=tu_page_id_aqui

# ID de tu cuenta de Instagram Business/Creator vinculada a la Página
META_IG_BUSINESS_ID=tu_ig_business_id_aqui

# Token de acceso de la Página, de larga duración (no el token de usuario, que expira en horas)
# ⚠️ SECRETO: nunca lo compartas ni lo subas a git
META_PAGE_ACCESS_TOKEN=tu_page_access_token_aqui

# Link del libro que se usa en el CTA de cada post
BOOK_URL=https://www.amazon.com/-/es/dp/B0G4NLY5TL

# Handle de Instagram ya existente (sin arroba)
IG_HANDLE=surfeandolicitaciones

# Instrucciones:
# 1. Copia este archivo: cp .env.example .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. El archivo .env está en .gitignore (no se subirá a GitHub)
