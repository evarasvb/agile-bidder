# Supabase Configuration
# ======================
# Obtén estas credenciales en: Supabase Dashboard → Settings → API

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://juiskeeutbaipwbeeezw.supabase.co
SUPABASE_URL=https://juiskeeutbaipwbeeezw.supabase.co

# Anon/Public Key (para el frontend)
# Obténla en: Supabase Dashboard → Settings → API → anon public key
VITE_SUPABASE_ANON_KEY=tu_anon_public_key_aqui

# Service Role Key (para ejecutar migraciones automáticamente)
# ⚠️ IMPORTANTE: Esta key es SECRET, nunca la compartas públicamente
# Obténla en: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto que Vercel agrega automáticamente al invocar los Cron Jobs.
CRON_SECRET=

# Secreto interno opcional para invocar directamente el scheduler de Supabase.
ENRICHMENT_SCHEDULER_TOKEN=

# Google Drive (integración por usuario) — SECRETS de las Edge Functions
# ======================
# Se configuran en Supabase Dashboard → Edge Functions → Secrets (NO en .env del front).
# Crea una credencial OAuth (tipo "Aplicación web") en Google Cloud Console:
#   - Scope: .../auth/drive.readonly
#   - URI de redirección autorizada:
#     https://juiskeeutbaipwbeeezw.supabase.co/functions/v1/google-drive-callback
# GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret

# Instrucciones:
# 1. Copia este archivo: cp .env.example .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. El archivo .env está en .gitignore (no se subirá a GitHub)
